# Caddy 는 Let's Encrypt 인증서를 자동 발급·갱신한다. ALB($16.4/월)를 쓰지 않는 이유다.

{$APP_DOMAIN} {
	encode gzip

	# Actuator 는 외부에 노출하지 않는다.
	# UptimeRobot 이 찌를 /actuator/health 만 예외로 허용하고 나머지는 감춘다.
	# 메트릭 수집은 컨테이너 네트워크 내부(app:8080)로 이뤄지므로 여기서 열 필요가 없다.
	@actuator_internal {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator_internal 404

	reverse_proxy app:8080 {
		health_uri /actuator/health/readiness
		health_interval 10s
		health_timeout 3s
	}

	log {
		output stdout
		format json
	}
}
