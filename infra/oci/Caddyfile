# Caddy 가 Let's Encrypt 인증서를 자동 발급·갱신한다. ALB·ACM 을 대신한다.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip

	# Actuator 는 헬스체크만 외부에 연다. 나머지는 감춘다.
	@actuator_internal {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	respond @actuator_internal 404

	# 요청마다 ID 를 만들어 앱에 넘기고 접근 로그에도 남긴다. 앱은 같은 값을 로그(MDC requestId)와
	# 응답 헤더에 싣는다. 클라이언트가 보낸 X-Request-Id 는 덮어써서 위조된 값이 로그에 섞이지 않게 한다.
	log_append request_id {http.request.uuid}

	reverse_proxy app:8080 {
		header_up X-Request-Id {http.request.uuid}
		health_uri /actuator/health/readiness
		health_interval 10s
		health_timeout 3s
	}

	# 접근 로그는 Grafana Cloud(외부)로 전송된다. IP 는 대역까지만 남기고,
	# 쿼리의 위치·이메일·OAuth 코드는 지운다(앱 로그는 좌표를 약 1km 단위로 남긴다).
	# Cookie·Authorization 헤더는 Caddy 가 기본으로 가린다.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>uri query {
					delete lat
					delete lng
					delete minLat
					delete maxLat
					delete minLng
					delete maxLng
					delete email
					delete code
					delete state
				}
			}
		}
	}
}

# 미디어 공개 주소. DB 에는 오브젝트 키만 있고 앱이 {STORAGE_PUBLIC_BASE_URL}/{key} 로 주소를 만든다.
# OCI Object Storage 공개 버킷을 원본으로 하는 media-cache(nginx 디스크 캐시)로 넘긴다.
{$CDN_DOMAIN} {
	reverse_proxy media-cache:8080
}
