// peakda prod (OCI) 관측 수집기.
//
// 앱 지표(/actuator/prometheus)는 Grafana Cloud Mimir 로, peakda compose 프로젝트의
// 컨테이너 stdout 로그는 Loki 로 보낸다. 대시보드·알림은 infra/grafana 에서 코드로 관리한다.
// 컨테이너 json-file 로그는 배포로 컨테이너가 바뀌면 지워지지만, 여기서 실시간으로
// 가져가므로 이미 보낸 로그는 Grafana 에 남는다.
//
// 서버 지표는 메모리·루트 디스크만 본다. 그 밖의 호스트·컨테이너 지표는 시계열 한도와 메모리 상한 때문에 수집하지 않는다.
// 자격증명은 /opt/peakda/.env 의 GRAFANA_CLOUD_* 값이다.

logging {
	// info 로 두면 자기 로그로 Loki 한도를 갉아먹는다.
	level  = "warn"
	format = "logfmt"
}

// ---------------------------------------------------------------------------
// 앱 지표
//
// 배치 잡·외부 API 쿼터·서킷브레이커·JVM·HikariCP·HTTP 가 전부 여기로 나온다.
// Caddy 가 /actuator/* 를 외부에서 404 로 막으므로 컨테이너 네트워크로 직접 붙는다.
// ---------------------------------------------------------------------------

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}
}

prometheus.scrape "app" {
	targets = [
		{
			__address__      = "app:8080",
			__metrics_path__ = "/actuator/prometheus",
			instance         = "peakda-server",
		},
	]
	job_name        = "peakda-server"
	scrape_interval = "30s"
	scrape_timeout  = "10s"
	forward_to      = [prometheus.relabel.app.receiver]
}

// ---------------------------------------------------------------------------
// 서버 메모리·디스크
//
// 같은 서버에 마인크래프트(최대 5GB)가 돌아 메모리가 모자라도 앱 지표로는 드러나지 않는다.
// 메모리·파일시스템 수집기만 켜고 루트 파일시스템만 본다(up 을 포함해 시계열 5개).
// ---------------------------------------------------------------------------

prometheus.exporter.unix "host" {
	rootfs_path    = "/rootfs"
	procfs_path    = "/host/proc"
	set_collectors = ["meminfo", "filesystem"]

	filesystem {
		// 루트(/)만 남긴다. 부트 파티션·컨테이너 오버레이 등은 뺀다.
		mount_points_exclude = "^/.+"
	}
}

// 수집기가 붙이는 job="integrations/unix"·instance=<컨테이너 ID> 를 고정값으로 바꾼다.
// instance 가 컨테이너 ID 면 수집기를 다시 만들 때마다 새 시계열이 생긴다.
discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "host"
	}

	rule {
		target_label = "instance"
		replacement  = "peakda-prod"
	}
}

prometheus.scrape "host" {
	targets         = discovery.relabel.host.output
	job_name        = "host"
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.app.receiver]
}

// 앱·서버 지표가 함께 거친다.
prometheus.relabel "app" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	// Grafana Cloud 무료 한도는 활성 시계열 10,000 개다. 앱은 기동 직후에만 600 개를 내고
	// 호출된 레포지토리 메서드·엔드포인트 조합이 늘수록 계속 불어난다(spring_data_repository_*,
	// http_server_requests_active_* 등). 대시보드·알림이 쓰는 지표만 통과시킨다.
	// 패널이나 알림에 새 지표를 쓰려면 여기에 먼저 추가한다.
	rule {
		source_labels = ["__name__"]
		action        = "keep"
		regex         = "up|scheduler_job_.+|external_api_.+|resilience4j_circuitbreaker_state|http_server_requests_seconds(_count|_sum)?|jvm_memory_(used|max)_bytes|jvm_gc_pause_seconds_(count|sum)|jvm_threads_live_threads|process_cpu_usage|process_uptime_seconds|hikaricp_connections_(active|idle|pending|max|timeout_total)|logback_events_total|node_memory_Mem(Available|Total)_bytes|node_filesystem_(avail|size)_bytes"
	}

	// HTTP 분위수는 0.95 만 쓴다. 0.99 는 엔드포인트 조합마다 시계열을 하나씩 더 만든다.
	rule {
		source_labels = ["__name__", "quantile"]
		regex         = "http_server_requests_seconds;0.99"
		action        = "drop"
	}

	// 스케줄러 지표의 잡 이름 태그(job)는 스크레이프가 붙이는 job="peakda-server" 와 겹쳐
	// exported_job 으로 밀려난다. 읽기 쉬운 job_name 으로 옮긴다.
	rule {
		source_labels = ["exported_job"]
		target_label  = "job_name"
	}

	rule {
		action = "labeldrop"
		regex  = "exported_job"
	}

	// 앱이 붙이는 env 태그는 SPRING_PROFILES_ACTIVE 에서 오므로 비어 있을 수 있다.
	// 대시보드·알림이 env 로 거르므로 수집기에서 확정한다. up 같은 스크레이프 지표에도 붙는다.
	rule {
		target_label = "env"
		replacement  = sys.env("PEAKDA_ENV")
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}

	external_labels = {
		env = sys.env("PEAKDA_ENV"),
	}
}

// ---------------------------------------------------------------------------
// 컨테이너 로그
//
// 같은 서버에 마인크래프트가 돈다. peakda compose 프로젝트 컨테이너만 골라
// 다른 서비스 로그(플레이어 IP·채팅)가 섞여 나가지 않게 한다.
//
// 라벨은 container 와 앱의 level 만 둔다. requestId 처럼 값이 매번 다른 것은
// structured metadata 로 두고 쿼리 시점에 거른다(라벨로 올리면 Loki 인덱스가 폭증한다).
// ---------------------------------------------------------------------------

discovery.docker "peakda" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "30s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=peakda"]
	}
}

discovery.relabel "peakda" {
	targets = discovery.docker.peakda.targets

	// 도커가 주는 이름은 "/peakda-app" 처럼 슬래시가 붙어 있다.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "peakda" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.peakda.output
	forward_to = [loki.process.peakda.receiver]
}

loki.process "peakda" {
	forward_to = [loki.write.grafana_cloud.receiver]

	// 로그 무료 한도는 월 50GB 다. 평소에는 하루 수십 MB 지만 에러가 루프를 돌면 한 컨테이너가
	// 초당 수천 줄을 낼 수 있다. 컨테이너마다 초당 100줄(순간 500줄)을 넘는 만큼은 버린다.
	// 최악이어도 컨테이너당 하루 약 2.6GB 라 한도 감시 알림이 먼저 울린다.
	stage.limit {
		rate          = 100
		burst         = 500
		by_label_name = "container"
		drop          = true
	}

	// 앱은 logstash 포맷 JSON 한 줄로 찍는다. MDC 의 requestId 도 최상위 필드로 들어간다.
	stage.match {
		selector = "{container=\"peakda-app\"}"

		stage.json {
			expressions = {
				level      = "level",
				logger     = "logger_name",
				thread     = "thread_name",
				request_id = "requestId",
				msg        = "message",
				stack      = "stack_trace",
			}
		}

		stage.labels {
			values = {
				level = "",
			}
		}

		stage.structured_metadata {
			values = {
				logger     = "",
				thread     = "",
				request_id = "",
			}
		}

	}

	// 본문을 message(+스택트레이스)로 바꿔 Explore 에서 파서 없이 읽히게 한다.
	// level 라벨은 JSON 으로 읽힌 줄에만 붙으므로, 기동 배너처럼 JSON 이 아닌 줄은
	// 여기에 걸리지 않고 원문 그대로 남는다.
	stage.match {
		selector = "{container=\"peakda-app\", level=~\".+\"}"

		stage.template {
			source   = "body"
			template = "{{ .msg }}{{ if .stack }}\n{{ .stack }}{{ end }}"
		}

		stage.output {
			source = "body"
		}
	}

	// PostgreSQL 느린 쿼리 로그(1초 이상)는 바인드 값을 DETAIL 줄로 따로 찍는다.
	// 이메일·좌표 같은 값이 그대로 들어가므로 그 줄만 버린다. 쿼리 본문과 소요 시간은 남는다.
	stage.match {
		selector = "{container=\"peakda-postgres\"}"

		stage.drop {
			expression          = "DETAIL:\\s+Parameters:"
			drop_counter_reason = "postgres_bind_parameters"
		}
	}

	// Caddy 접근 로그. 본문은 JSON 그대로 두고(| json 으로 펼쳐 본다)
	// 자주 거르는 값만 metadata 로 올린다. request_id 는 앱 로그와 같은 값이다.
	// IP 대역 축소와 쿼리의 위치·이메일·OAuth 코드 삭제는 Caddyfile 의 log filter 가 맡는다.
	stage.match {
		selector = "{container=\"peakda-caddy\"}"

		stage.json {
			expressions = {
				status     = "status",
				request_id = "request_id",
			}
		}

		stage.structured_metadata {
			values = {
				status     = "",
				request_id = "",
			}
		}
	}
}
