# Copy to terraform.tfvars locally; never commit real values.
region                 = "ap-northeast-2"
domain_name            = "peakda.com"
subdomain              = "api"
alert_email            = "replace@example.com"
github_allowed_subjects = ["repo:OWNER/REPOSITORY:environment:production"]

# Phase 1: leave desired/min at 0 while creating RDS, Redis, SSM and buckets.
desired_count = 0
min_capacity  = 0

# Phase 2: set these to 2 after image and all SecureString values are ready.
# desired_count = 2
# min_capacity  = 2
image_tag                = "replace-with-git-sha"
migration_image_tag      = "replace-with-migration-tag"
migration_source_s3_uri  = "s3://peakda-prod-storage-ACCOUNT_ID/migration/dev-source.dump"

app_parameters = {
  # FCM_PROJECT_ID is intentionally plain; service-account credentials remain SecureString.
  FCM_PROJECT_ID       = "peakda"
  STORAGE_PRESIGNED_URL_TTL_SECONDS = "3600"
}

app_secret_names = [
  "GOOGLE_CLIENT_ID",
  "GOOGLE_CLIENT_SECRET",
  "KAKAO_CLIENT_ID",
  "KAKAO_CLIENT_SECRET",
  "NAVER_CLIENT_ID",
  "NAVER_CLIENT_SECRET",
  "JWT_SECRET",
  "FCM_SERVICE_ACCOUNT_BASE64",
  "KTO_SERVICE_KEY",
  "KMA_SERVICE_KEY",
  "PUBDATA_FESTIVAL_SERVICE_KEY",
]

# 웹 프론트엔드(Vercel) 커스텀 도메인 연결.
# Vercel 프로젝트 Settings -> Domains 화면이 표시하는 값을 그대로 넣는다.
# CNAME 대상과 A 레코드 IP 모두 프로젝트마다 다르므로 추측하지 않는다.
# 빈 문자열이면 해당 레코드를 만들지 않는다. 자세한 절차는 이 디렉터리의 README.md 참고.
vercel_apex_ip          = "" # 예: 216.198.79.1
vercel_www_cname        = "" # 예: d1d4fc829fe7bc7c.vercel-dns-017.com
vercel_verification_txt = "" # Vercel 이 소유 확인을 요구할 때만
